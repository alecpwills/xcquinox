# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# profraw files from LLVM? Unclear exactly what triggers this
# There are reports this comes from LLVM profiling, but also Xcode 9.
*profraw

# In-tree generated files
*/_version.py

# Notebook derivative files from testing processes
notebooks/tmp*
notebooks/xc.eqx*
notebooks/*.dat
notebooks/NOSYNC
notebooks/NOSYNC/*

xcquinox/tests/*.dat
xcquinox/tests/tmp*
xcquinox/tests/xc.eqx*
xcquinox/tests/testmakenet/

# Local-only analysis reports (never committed): the annotated decks (notes after every
# slide) and the full v7 report stay off the remote; the plain decks and the summary are tracked
reports/v7/*_annotated.tex
reports/v7/*_annotated.pdf
reports/v7/REPORT_v7_*.md
reports/v7/REPORT_v7_*.tex
reports/v7/REPORT_v7_*.pdf
reports_local/
# the figure sets the suite writes beside itself are not tracked there; the sets the
# documents cite are tracked under reports/
tools/analysis/figures_*/

# Training-run artifact directories. These are large binary checkpoint
# trees (xc.eqx, model.eqx, transfer_results, aggregate.json, figures/)
# that are regenerated by re-running the corresponding step generator;
# they were already de-facto untracked and are recorded here so
# `git add -A` after a cleanup or notebook-run doesn't try to commit
# multi-GB blobs.
notebooks/checkpoints_step4/
notebooks/checkpoints_step5/
notebooks/checkpoints_step6/
notebooks/checkpoints_step7/
# every checkpoints directory a notebook writes under notebooks/
notebooks/checkpoints*/
notebooks/.jax_compilation_cache/

# Upstream GMTKN55 benchmark checkout (an external dataset, the source of truth for
# the BH76/BH76RC references). Fetched, not committed -- provenance (URL + pinned
# commit) + the extracted reference values live in data/gmtkn55/PROVENANCE.md,
# the one tracked file under that directory.
data/gmtkn55/*
!data/gmtkn55/PROVENANCE.md

# constraint+pretraining demo: regenerable scratch (PBE precompute, pretrain
# checkpoints, run log) and the output figure.
tools/analysis/_constraint_demo_work/
tools/analysis/demo_logs/
tools/analysis/_constraint_demo*.log
tools/analysis/constraint_pretrain_gmtkn55_demo*.png
tools/analysis/multimode_*.png

# Stray local scratch that `git add -A` would otherwise sweep in: an accidental
# nested notebooks/ copy, a test-run eqx checkpoint tree, and a representative-
# subset analysis cache. Regenerable / not source.
notebooks/notebooks/
/testmakenet/
tools/analysis/bh76w411_representative_subsets/

# Working scratch: diagnostic pulls, one-off helper scripts handed to the
# operator (pull_refs.sh and kin), repro drivers and their logs. Never
# committed; the durable record of any finding lives in the
# committed tests.
/scratch/

# LaTeX build artifacts of the decks and the summary (the PDFs are tracked or ignored by name)
reports/v7/*.aux
reports/v7/*.nav
reports/v7/*.out
reports/v7/*.snm
reports/v7/*.toc
reports/v7/*.log

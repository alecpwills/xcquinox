*/_version.py

# Notebook derivative files from testing processes
notebooks/tmp*
notebooks/xc.eqx*
notebooks/*.dat
notebooks/NOSYNC
notebooks/NOSYNC/*

xcquinox/tests/*.dat
xcquinox/tests/tmp*
xcquinox/tests/xc.eqx*
xcquinox/tests/testmakenetnotebooks/checkpoints/

# Local-only analysis reports (never committed)
reports_local/

# Training-run artifact directories. These are large binary checkpoint
# trees (xc.eqx, model.eqx, transfer_results, aggregate.json, figures/)
# that are regenerated by re-running the corresponding step generator;
# they were already de-facto untracked and are recorded here so
# `git add -A` after a cleanup or notebook-run doesn't try to commit
# multi-GB blobs.
notebooks/checkpoints_step4/
notebooks/checkpoints_step5/
notebooks/checkpoints_step6/
notebooks/checkpoints_step7/
notebooks/.jax_compilation_cache/

# Upstream GMTKN55 benchmark clone (190M external dataset, source of truth for
# BH76/BH76RC references). Fetched, not committed — provenance (URL + pinned
# commit) + the extracted reference values live in
# scripts/script_data/GMTKN55_BH76RC_PROVENANCE.md.
scripts/script_data/gmtkn55/

# constraint+pretraining demo: regenerable scratch (PBE precompute, pretrain
# checkpoints, run log) and the output figure.
notebooks/analysis/_constraint_demo_work/
notebooks/analysis/_constraint_demo*.log
notebooks/analysis/constraint_pretrain_gmtkn55_demo*.png

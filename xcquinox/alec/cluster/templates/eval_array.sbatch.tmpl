#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
${ALLOC_LINES}${MEM_LINE}#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --array=0-${ARRAY_MAX}%${THROTTLE}
#SBATCH --output=${RUN_DIR}/logs/eval_%A_%a.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -euo pipefail

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
# The evaluation's PySCF work runs in this process on two paths -- the final
# serial tier that finishes what the shard workers left, and the whole-serial
# fallback when the parallel path is off or raises -- so this process's
# OpenMP and OpenBLAS pools are capped at min(allocation, ${PYSCF_POOL_THREADS_MAX})
# (parallel.pyscf_pool_threads) like every other PySCF-driving process; the
# shard workers set their own pools (parallel._thread_env) and XLA sizes the
# model's pool itself. Sized to the allocation, the two spin-waiting pools
# stall a PySCF SCF loop (workflow-matrix job 2134488: about ten minutes per
# molecule at 40 threads on a 40-core node against 8 s at four).
PYSCF_THREADS=$${SLURM_CPUS_PER_TASK:-${PYSCF_POOL_THREADS_MAX}}
case "$$PYSCF_THREADS" in ''|*[!0-9]*) PYSCF_THREADS=${PYSCF_POOL_THREADS_MAX} ;; esac
PYSCF_THREADS=$$(( 10#$$PYSCF_THREADS ))
[ "$$PYSCF_THREADS" -ge 1 ] || PYSCF_THREADS=1
[ "$$PYSCF_THREADS" -le ${PYSCF_POOL_THREADS_MAX} ] || PYSCF_THREADS=${PYSCF_POOL_THREADS_MAX}
export OMP_NUM_THREADS="$$PYSCF_THREADS"
export MKL_NUM_THREADS="$$PYSCF_THREADS"
export OPENBLAS_NUM_THREADS="$$PYSCF_THREADS"
echo "[thread-caps] allocation=$${SLURM_CPUS_PER_TASK:-unset} -> OMP/MKL/OPENBLAS=$$PYSCF_THREADS"
${BENCH_REFS_ENV_LINE}
${SEED_ENV_LINES}
# --- JAX/XLA CPU backend (eval is CPU-only) --------------------------------
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=true intra_op_parallelism_threads=$$SLURM_CPUS_PER_TASK --xla_force_host_platform_device_count=1"

# --- eval task -------------------------------------------------------------
python -m xcquinox.alec.cluster._eval_one_spec ${RUN_DIR} $${SLURM_ARRAY_TASK_ID}

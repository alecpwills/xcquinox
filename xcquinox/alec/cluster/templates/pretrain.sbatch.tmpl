#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
${ALLOC_LINES}${MEM_LINE}#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --array=0-${ARRAY_MAX}%${THROTTLE}
#SBATCH --output=${RUN_DIR}/logs/pretrain_%A_%a.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -euo pipefail

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
# The fidelity certificate's parent routes (one PySCF SCF per system) run
# PySCF's OpenMP pool and numpy's OpenBLAS pool at min(allocation, ${PYSCF_POOL_THREADS_MAX})
# threads each (parallel.pyscf_pool_threads): sized to the allocation, the two
# spin-waiting pools stall a loop of small dense operations -- measured at
# about ten minutes per molecule at 40 threads on a 40-core node against 8 s
# at four for a reference build (the curve is on parallel.PYSCF_POOL_THREADS_MAX).
# XLA sizes the pretraining's own pool from the CPUs the task may run on.
PYSCF_THREADS=$${SLURM_CPUS_PER_TASK:-${PYSCF_POOL_THREADS_MAX}}
[ "$$PYSCF_THREADS" -le ${PYSCF_POOL_THREADS_MAX} ] || PYSCF_THREADS=${PYSCF_POOL_THREADS_MAX}
export OMP_NUM_THREADS="$$PYSCF_THREADS"
export MKL_NUM_THREADS="$$PYSCF_THREADS"
export OPENBLAS_NUM_THREADS="$$PYSCF_THREADS"
echo "[thread-caps] allocation=$${SLURM_CPUS_PER_TASK:-unset} -> OMP/MKL/OPENBLAS=$$PYSCF_THREADS"

# --- JAX/XLA CPU backend ---------------------------------------------------
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=true intra_op_parallelism_threads=$$SLURM_CPUS_PER_TASK --xla_force_host_platform_device_count=1"

# --- pretrain task (one array index per distinct architecture) -------------
python -m xcquinox.alec.cluster._pretrain ${RUN_DIR} $${SLURM_ARRAY_TASK_ID}

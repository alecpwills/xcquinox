#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
${ALLOC_LINES}${MEM_LINE}#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --output=${RUN_DIR}/logs/benchmark_refs_%j.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -euo pipefail

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
export OMP_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export MKL_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$$SLURM_CPUS_PER_TASK

# --- hold-out benchmark reference densities (single job, resumable) ---------
# CCSD + PBE densities for the full W4-11+BH76 pool (no OEP stage); every
# species' final npz is atomic + skip-if-complete, so a timeout/requeue
# simply resumes. Starts once the train array has BEGUN (--dependency=after).
python -m xcquinox.alec.benchmark_refs \
  --out-dir ${BENCH_REFS_DIR} \
  --pool all \
  --basis ${BASIS} \
  --grid-level ${GRID_LEVEL}${BENCH_DF_FLAGS}

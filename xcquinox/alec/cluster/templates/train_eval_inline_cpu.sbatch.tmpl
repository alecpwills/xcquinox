#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
${ALLOC_LINES}${MEM_LINE}#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --array=0-${ARRAY_MAX}%${THROTTLE}
#SBATCH --signal=B:TERM@${SIGTERM_GRACE}
#SBATCH --output=${RUN_DIR}/logs/train_eval_%A_%a.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -uo pipefail
# NOTE: NOT `set -e` — we intentionally tolerate eval failure so the train
# checkpoint (already on disk from _train_task) survives a crash in
# _eval_one_spec. See the `|| true` guard on the eval invocation below.

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
export OMP_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export MKL_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$$SLURM_CPUS_PER_TASK
${BENCH_REFS_ENV_LINE}
# --- JAX/XLA CPU backend ---------------------------------------------------
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=true intra_op_parallelism_threads=$$SLURM_CPUS_PER_TASK --xla_force_host_platform_device_count=1"

# --- train task ------------------------------------------------------------
# 2026-05-29 inline-eval mode: this single SLURM task does BOTH train AND
# eval for the spec at $$SLURM_ARRAY_TASK_ID. This shell MUST survive the train
# phase to run eval afterward, so the worker cannot be `exec`'d as the batch
# PID (as the non-inline templates do). Consequently a wall-clock
# `--signal=B:TERM@grace` is delivered to THIS shell, not the worker. We run the
# worker in the background and forward SIGTERM to its PID via a trap, so the
# worker's grace handler (_train_task._install_sigterm_handler) still fires and
# writes the timeout failure.json — matching the non-inline exec'd behavior.
python -m xcquinox.alec.cluster._train_task ${RUN_DIR} $${SLURM_ARRAY_TASK_ID} &
train_pid=$$!
trap 'echo "[inline-eval] forwarding SIGTERM to train pid $${train_pid}"; kill -TERM $${train_pid} 2>/dev/null' TERM
wait $${train_pid}
train_exit=$$?
# `wait` returns 128+signum when interrupted by the trapped SIGTERM; re-wait
# until the worker has actually exited so we capture ITS real exit code (and the
# grace handler has had time to write failure.json).
while [ $${train_exit} -ge 128 ] && kill -0 $${train_pid} 2>/dev/null; do
  wait $${train_pid}
  train_exit=$$?
done
trap - TERM
echo "[inline-eval] _train_task exit code: $${train_exit}"

# Only run eval if train succeeded. A failed train means no model.eqx for
# _eval_one_spec to load; skip and exit with the train's status code.
if [ "$${train_exit}" -eq 0 ]; then
  echo "[inline-eval] running _eval_one_spec inline ..."
  python -m xcquinox.alec.cluster._eval_one_spec ${RUN_DIR} $${SLURM_ARRAY_TASK_ID} || \
    echo "[inline-eval] WARNING: _eval_one_spec failed (train checkpoint preserved)"
fi

exit $${train_exit}

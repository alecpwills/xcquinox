#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
${ALLOC_LINES}${MEM_LINE}#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --array=0-${ARRAY_MAX}%${THROTTLE}
#SBATCH --signal=B:TERM@${SIGTERM_GRACE}
#SBATCH --output=${RUN_DIR}/logs/train_%A_%a.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -euo pipefail

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
export OMP_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export MKL_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$$SLURM_CPUS_PER_TASK

# --- JAX/XLA CPU backend ---------------------------------------------------
# 2026-07-04: dropped the bare `intra_op_parallelism_threads=...` token (it was
# missing its `--xla_` prefix, so XLA silently ignored it), and added
# `--xla_llvm_disable_expensive_passes=true` to cut LLVM codegen PEAK MEMORY when
# compiling the fused SCF-step kernel for large bases -- 6-311++G(3df,2pd)+grid3
# OOMed LLVM ("Cannot allocate memory"/std::bad_alloc) on 128 GB nodes. If a
# compile still OOMs, also add `--xla_backend_optimization_level=1`. See HISTORY.
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=true --xla_force_host_platform_device_count=1 --xla_llvm_disable_expensive_passes=true"

# --- train task ------------------------------------------------------------
# exec so the worker (PID == batch-step PID) receives the #SBATCH
# --signal=B:TERM@<grace> wall-clock pre-kill signal and its SIGTERM handler
# can record a timeout failure.json. Without exec the signal hits this shell,
# not the Python process, and the grace handler never fires.
exec python -m xcquinox.alec.cluster._train_task ${RUN_DIR} $${SLURM_ARRAY_TASK_ID}

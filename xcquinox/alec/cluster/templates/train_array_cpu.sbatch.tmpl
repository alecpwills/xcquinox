#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
#SBATCH --mem=${MEM}
#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --array=0-${ARRAY_MAX}%${THROTTLE}
#SBATCH --signal=B:TERM@${SIGTERM_GRACE}
#SBATCH --output=${RUN_DIR}/logs/train_%A_%a.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -euo pipefail

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
export OMP_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export MKL_NUM_THREADS=$$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$$SLURM_CPUS_PER_TASK

# --- JAX/XLA CPU backend ---------------------------------------------------
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=true intra_op_parallelism_threads=$$SLURM_CPUS_PER_TASK --xla_force_host_platform_device_count=1"

# --- train task ------------------------------------------------------------
python -m xcquinox.alec.cluster._train_task ${RUN_DIR} $${SLURM_ARRAY_TASK_ID}

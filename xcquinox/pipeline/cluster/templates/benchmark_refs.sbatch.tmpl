#!/usr/bin/env bash
#SBATCH --job-name=${JOB_NAME}
#SBATCH --partition=${PARTITION}
#SBATCH --time=${TIME}
${ALLOC_LINES}${MEM_LINE}#SBATCH --cpus-per-task=${CPUS_PER_TASK}
#SBATCH --output=${RUN_DIR}/logs/benchmark_refs_%j.out
${MAIL_USER_LINE}${MAIL_TYPE_LINE}${ACCOUNT_LINE}
set -euo pipefail
# The node stages run at the checkout: sbatch's default working directory is
# the submit directory, so a submit from elsewhere must not shift it.
cd "${REPO_ROOT}"

# --- conda activation ------------------------------------------------------
${CONDA_ACTIVATION}

# --- thread caps -----------------------------------------------------------
# The held-out reference build (SCF, CCSD, OEP per species) runs PySCF's
# OpenMP pool and numpy's OpenBLAS pool at min(allocation, ${PYSCF_POOL_THREADS_MAX})
# threads each (parallel.pyscf_pool_threads): sized to the allocation, the two
# spin-waiting pools stall the small dense operations the build is made of --
# measured at about ten minutes per molecule at 40 threads on a 40-core node
# against 8 s at four (the curve is on parallel.PYSCF_POOL_THREADS_MAX).
PYSCF_THREADS=$${SLURM_CPUS_PER_TASK:-${PYSCF_POOL_THREADS_MAX}}
case "$$PYSCF_THREADS" in ''|*[!0-9]*) PYSCF_THREADS=${PYSCF_POOL_THREADS_MAX} ;; esac
PYSCF_THREADS=$$(( 10#$$PYSCF_THREADS ))
[ "$$PYSCF_THREADS" -ge 1 ] || PYSCF_THREADS=1
[ "$$PYSCF_THREADS" -le ${PYSCF_POOL_THREADS_MAX} ] || PYSCF_THREADS=${PYSCF_POOL_THREADS_MAX}
export OMP_NUM_THREADS="$$PYSCF_THREADS"
export MKL_NUM_THREADS="$$PYSCF_THREADS"
export OPENBLAS_NUM_THREADS="$$PYSCF_THREADS"
echo "[thread-caps] allocation=$${SLURM_CPUS_PER_TASK:-unset} -> OMP/MKL/OPENBLAS=$$PYSCF_THREADS"

# --- hold-out benchmark reference densities (single job, resumable) ---------
# CCSD + PBE densities for the species of the held-out pools the run names
# (no OEP stage), capped at the configured species size when one is stated;
# every species' final npz is atomic + skip-if-complete, so a timeout/requeue
# simply resumes. Starts once the train array has BEGUN (--dependency=after).
# A species that KILLS its process is deferred to the end of the next
# attempt's queue (its _inflight marker is the death certificate), and this
# bounded retry then banks every other species before re-entering it.
ATTEMPTS=3
rc=1
attempt=0
while [ "$$attempt" -lt "$$ATTEMPTS" ]; do
  attempt=$$((attempt + 1))
  rc=0
  python -m xcquinox.pipeline.benchmark_refs \
    --out-dir "${BENCH_REFS_DIR}" \
    --pool ${BENCH_POOLS} \
    --basis "${BASIS}" \
    --grid-level ${GRID_LEVEL}${BENCH_DF_FLAGS} || rc=$$?
  n_ok=$$(ls "${BENCH_REFS_DIR}" 2>/dev/null | grep -c '\.npz$$' || true)
  echo "[benchmark-refs] attempt $${attempt}/$${ATTEMPTS} rc=$${rc} complete npz=$${n_ok}"
  if [ "$$rc" -eq 0 ]; then break; fi
done
if [ "$$rc" -ne 0 ]; then
  echo "[benchmark-refs] FAILED rc=$${rc} after $${attempt} attempt(s)"
  exit "$$rc"
fi
